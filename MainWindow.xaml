<Window x:Class="Observer.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Observer.ControlCenter.Services"
        Icon="/Assets/ObserverBrand.png" Title="{x:Static loc:UiText.X001}" Width="1450" Height="900"
        MinWidth="1040" MinHeight="675" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Opacity="0" Background="Transparent"
        Foreground="{StaticResource TextMain}" FontFamily="Segoe UI" Loaded="Window_Loaded">
 <Window.Resources>
    <Style x:Key="NavGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
      <Setter Property="Margin" Value="9,13,0,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
 </Window.Resources>
 <Border x:Name="GlassShell" BorderBrush="#71516B74" BorderThickness="1" Background="{StaticResource WindowBg}">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="87"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="36"/>
  </Grid.RowDefinitions>

  <!-- Custom chrome / header -->
  <Border Grid.Row="0" BorderBrush="#1A303A" BorderThickness="0,0,0,1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F510141A" Offset="0"/>
        <GradientStop Color="#F707090D" Offset="0.65"/>
        <GradientStop Color="#F5101015" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="17" BorderBrush="#257D8C" BorderThickness="1" Margin="20,0,16,0" Background="#080C12">
        <Grid><Image Source="/Assets/ObserverBrand.png" Margin="4" Stretch="UniformToFill"/></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="OBSERVER" FontSize="27" FontWeight="Bold" Foreground="#F5FCFF"/>
          <TextBlock Text="{x:Static loc:UiText.X002}" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="17"/>
          <TextBlock x:Name="HeaderVersionText" Text="{x:Static loc:UiText.X003}" Margin="14,12,0,0" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
        </StackPanel>
        <TextBlock Text="{x:Static loc:UiText.X004}" FontSize="10" Foreground="#92B0C3" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,14,0" VerticalAlignment="Center">
        <Border BorderBrush="#206C6F" Background="#113C41" CornerRadius="11" Padding="12,7" Margin="0,0,12,0">
          <TextBlock Text="{x:Static loc:UiText.X005}" FontSize="10" FontWeight="SemiBold" Foreground="#70E5D7"/>
        </Border>
        <Button x:Name="BtnUpdates" Content="{x:Static loc:UiText.X006}" Style="{StaticResource FlatButton}" Click="Updates_Click" ToolTip="{x:Static loc:UiText.HintUpdates}" Margin="0,0,8,0"/>
        <Button x:Name="BtnIsland" Content="{x:Static loc:UiText.X007}" Style="{StaticResource FlatButton}" Click="Island_Click" ToolTip="{x:Static loc:UiText.HintIsland}" Margin="0,0,8,0"/>
        <Button Content="—" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintMinimize}" Click="Minimize_Click" Margin="0,0,5,0"/>
        <Button Content="▢" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintMaximize}" Click="Maximize_Click" Margin="0,0,5,0"/>
        <Button Content="×" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintClose}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Navigation and workspace -->
  <Grid x:Name="WorkspacePanel" Grid.Row="1" Margin="13,13,13,10">
    <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="246"/>
      <ColumnDefinition Width="13"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="5,15,5,3">
           <Border CornerRadius="10" Background="#10191F" BorderBrush="#215769" BorderThickness="1" Padding="10">
             <StackPanel>
               <TextBlock Text="{x:Static loc:UiText.X008}" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
               <TextBlock Text="{x:Static loc:UiText.X009}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
               <TextBlock Text="{x:Static loc:UiText.X010}" Style="{StaticResource LabelSmall}" Margin="0,4,0,0"/>
             </StackPanel>
           </Border>
           <TextBlock Margin="5,12,0,0" FontSize="10" Foreground="#7192A6" Text="{x:Static loc:UiText.X011}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,4,0">
          <TextBlock Text="{x:Static loc:UiText.WorkspaceHeading}" FontSize="15" FontWeight="SemiBold" Margin="9,2,0,3"/>
          <TextBlock Text="{x:Static loc:UiText.WorkspaceHint}" Style="{StaticResource LabelSmall}" Margin="9,0,5,8"/>
          <TextBlock Text="{x:Static loc:UiText.GroupAnalytics}" Style="{StaticResource NavGroupTitle}"/>
          <Button x:Name="NavOverview" Content="{x:Static loc:UiText.X013}" Style="{StaticResource NavigationButton}" Click="Overview_Click" ToolTip="{x:Static loc:UiText.HintOverview}"/>
          <Button Content="{x:Static loc:UiText.AccessAnalyzerLabel}" Style="{StaticResource NavigationButton}" Click="AccessAnalyzer_Click"/>
          <Button x:Name="NavConnections" Content="{x:Static loc:UiText.X015}" Style="{StaticResource NavigationButton}" Click="Connections_Click" ToolTip="{x:Static loc:UiText.HintConnections}"/>
          <Button x:Name="NavTraffic" Content="{x:Static loc:UiText.X014}" Style="{StaticResource NavigationButton}" Click="Traffic_Click" ToolTip="{x:Static loc:UiText.HintTraffic}"/>
          <Separator Style="{StaticResource GlassSeparator}"/>
          <TextBlock Text="{x:Static loc:UiText.GroupCollect}" Style="{StaticResource NavGroupTitle}"/>
          <Button Content="{x:Static loc:UiText.KeeneticConnect}" Style="{StaticResource NavigationButton}" Click="LegacyCollect_Click" ToolTip="{x:Static loc:UiText.HintNat}"/>
          <Button Content="{x:Static loc:UiText.LegacyVpn}" Style="{StaticResource NavigationButton}" Click="LegacyVpn_Click" ToolTip="{x:Static loc:UiText.HintVpn}"/>
          <Button Content="{x:Static loc:UiText.LegacyTraffic}" Style="{StaticResource NavigationButton}" Click="LegacyTraffic_Click" ToolTip="{x:Static loc:UiText.HintCollectTraffic}"/>
          <Separator Style="{StaticResource GlassSeparator}"/>
          <TextBlock Text="{x:Static loc:UiText.GroupReports}" Style="{StaticResource NavGroupTitle}"/>
          <Button x:Name="NavReports" Content="{x:Static loc:UiText.X016}" Style="{StaticResource NavigationButton}" Click="Reports_Click" ToolTip="{x:Static loc:UiText.HintReports}"/>
          <Button Content="{x:Static loc:UiText.X020}" Style="{StaticResource NavigationButton}" Click="Import_Click" ToolTip="{x:Static loc:UiText.HintImport}"/>
          <Separator Style="{StaticResource GlassSeparator}"/>
          <TextBlock Text="{x:Static loc:UiText.GroupSystem}" Style="{StaticResource NavGroupTitle}"/>
          <Button Content="{x:Static loc:UiText.LegacyTools}" Style="{StaticResource NavigationButton}" Click="LegacyTools_Click" ToolTip="{x:Static loc:UiText.HintTools}"/>
          <Button x:Name="NavHelp" Content="{x:Static loc:UiText.HelpButton}" Style="{StaticResource NavigationButton}" Click="Help_Click" ToolTip="{x:Static loc:UiText.HelpHint}"/>
          <Button x:Name="GlassModeButton" Visibility="Collapsed" Content="{x:Static loc:UiText.X022}" Style="{StaticResource NavigationButton}" Click="Glass_Click"/>
         </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="94"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="142"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="13" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="170"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{x:Static loc:UiText.X028}" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="PageSubtitle" Text="{x:Static loc:UiText.X029}" Style="{StaticResource LabelSmall}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,8,0">
            <TextBlock Text="{x:Static loc:UiText.X030}" Style="{StaticResource LabelSmall}" Margin="0,0,0,4"/>
            <TextBox x:Name="RouterIP" Text="" Style="{StaticResource TextInput}" ToolTip="{x:Static loc:UiText.X031}"/>
          </StackPanel>
          <Button Grid.Column="2" Content="{x:Static loc:UiText.LegacyConnect}" Style="{StaticResource AccentButton}" Margin="6,17,0,1" Click="LegacyCollect_Click" ToolTip="{x:Static loc:UiText.HintNat}"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X033}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiDevices" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X034}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiTraffic" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X035}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiActive" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="6" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X036}" Style="{StaticResource LabelSmall}"/><TextBlock Text="CSV" Foreground="{DynamicResource Accent}" FontSize="26" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="13">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,2,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TableTitle" Text="{x:Static loc:UiText.X037}" FontSize="13" FontWeight="Bold"/>
                <TextBlock x:Name="TableHint" Text="{x:Static loc:UiText.X038}" Style="{StaticResource LabelSmall}" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextInput}" TextChanged="SearchBox_TextChanged"
                       ToolTip="{x:Static loc:UiText.X039}" Margin="5,0,8,0"/>
              <Button Grid.Column="2" Content="{x:Static loc:UiText.X040}" Style="{StaticResource AccentButton}" Click="Import_Click"/>
            </Grid>
            <DataGrid Grid.Row="1" x:Name="TrafficGrid" AlternationCount="2" Visibility="Visible">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Width="44" Binding="{Binding Rank}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X041}" MinWidth="150" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="IP" Width="125" Binding="{Binding IP}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X042}" Width="96" Binding="{Binding Download}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X043}" Width="96" Binding="{Binding Upload}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X044}" Width="96" Binding="{Binding Total}"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" Visibility="Collapsed" AutoGenerateColumns="True" AlternationCount="2"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static loc:UiText.X045}" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="{x:Static loc:UiText.X046}" Style="{StaticResource LabelSmall}" Margin="0,4,0,12"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="TopBars">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,11">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="#D3E8EE" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                    </Grid>
                    <Border Height="7" CornerRadius="4" Background="#1F3345" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Accent}" Width="{Binding Width}" HorizontalAlignment="Left" CornerRadius="4"/>
                    </Border>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.X047}" Foreground="#8AA7B9" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:UiText.X048}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:UiText.X049}" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,13,0"/>
              <Button Content="{x:Static loc:UiText.X050}" Style="{StaticResource FlatButton}" Click="CopyAllLogs_Click" ToolTip="{x:Static loc:UiText.X051}" Padding="9,5"/>
            </StackPanel>
          </Grid>
          <RichTextBox Grid.Row="1" x:Name="LogList" Background="#F506080B" Foreground="#BBCBD8"
                       FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="7,4"
                       IsReadOnly="True" IsDocumentEnabled="False" AcceptsTab="False"
                       SelectionBrush="#4D458D98" CaretBrush="#43D9DC"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
             <FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="11"
                           ColumnWidth="999999" TextAlignment="Left"/>
          </RichTextBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  <!-- Non-blocking in-app update notification; app must be running. -->
  <Border x:Name="UpdateToast" Grid.Row="1" Panel.ZIndex="15" Visibility="Collapsed"
          Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"
          Padding="17" CornerRadius="14" BorderThickness="1" BorderBrush="#48A6AF" Background="#F5102026">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="7" Opacity="0.6"/></Border.Effect>
    <StackPanel>
      <TextBlock Text="{x:Static loc:UiText.X052}" FontWeight="Bold" Foreground="#5FE7DD" FontSize="12"/>
      <TextBlock x:Name="UpdateToastText" Text="{x:Static loc:UiText.X053}" Foreground="White" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="{x:Static loc:UiText.X054}" Style="{StaticResource AccentButton}" Click="Updates_Click" Margin="0,0,9,0"/>
        <Button Content="{x:Static loc:UiText.X055}" Style="{StaticResource FlatButton}" Click="DismissToast_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
  <Grid Grid.Row="2" Background="#F708090C">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="BottomStatus" Text="{x:Static loc:UiText.X056}" VerticalAlignment="Center"
               Foreground="#74C6CA" FontSize="11" Margin="18,0,0,0"/>
    <TextBlock Grid.Column="1" x:Name="FooterVersionText" Text="{x:Static loc:UiText.X057}" Foreground="#6D91A5" FontSize="10" Margin="0,0,18,0" VerticalAlignment="Center"/>
     <Thumb Grid.ColumnSpan="2" x:Name="CornerResizeGrip" Width="20" Height="20" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,1,1" Cursor="SizeNWSE"
            DragDelta="CornerResizeGrip_DragDelta" ToolTip="{x:Static loc:UiText.X058}">
       <Thumb.Template>
         <ControlTemplate TargetType="Thumb">
           <Grid Background="Transparent">
             <Path Stroke="#5A9EA9" StrokeThickness="1.6"
                   Data="M 15,5 L 5,15 M 15,10 L 10,15"/>
           </Grid>
         </ControlTemplate>
       </Thumb.Template>
     </Thumb>
  </Grid>
 </Grid>
 </Border>
</Window>
