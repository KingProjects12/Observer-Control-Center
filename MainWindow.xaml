<Window x:Class="Observer.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/ObserverBrand.png" Title="Observer Control Center — Preview" Width="1450" Height="900"
        MinWidth="1040" MinHeight="675" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Opacity="0" Background="Transparent"
        Foreground="{StaticResource TextMain}" FontFamily="Segoe UI" Loaded="Window_Loaded">
 <Window.Resources>
    <Style x:Key="NavGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
      <Setter Property="Margin" Value="9,20,0,12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
 </Window.Resources>
 <Border x:Name="GlassShell" BorderBrush="#71516B74" BorderThickness="1" Background="{StaticResource WindowBg}">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="87"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="36"/>
  </Grid.RowDefinitions>

  <!-- Custom chrome / header -->
  <Border Grid.Row="0" BorderBrush="#1A303A" BorderThickness="0,0,0,1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F510141A" Offset="0"/>
        <GradientStop Color="#F707090D" Offset="0.65"/>
        <GradientStop Color="#F5101015" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="17" BorderBrush="#257D8C" BorderThickness="1" Margin="20,0,16,0" Background="#080C12">
        <Grid><Image Source="/Assets/ObserverBrand.png" Margin="4" Stretch="UniformToFill"/></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="OBSERVER" FontSize="27" FontWeight="Bold" Foreground="#F5FCFF"/>
          <TextBlock Text="  //  CONTROL CENTER" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="17"/>
          <TextBlock x:Name="HeaderVersionText" Text="  BLACK GLASS" Margin="14,12,0,0" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
        </StackPanel>
        <TextBlock Text="WHO  →  WHERE  →  WHEN      /      NETWORK ANALYTICS" FontSize="10" Foreground="#92B0C3" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,14,0" VerticalAlignment="Center">
        <Border BorderBrush="#206C6F" Background="#113C41" CornerRadius="11" Padding="12,7" Margin="0,0,12,0">
          <TextBlock Text="●  LOCAL · READ-ONLY" FontSize="10" FontWeight="SemiBold" Foreground="#70E5D7"/>
        </Border>
        <Button x:Name="BtnUpdates" Content="↻  ОБНОВЛЕНИЯ" Style="{StaticResource FlatButton}" Click="Updates_Click" Margin="0,0,8,0"/>
        <Button x:Name="BtnIsland" Content="◔  ОСТРОВОК" Style="{StaticResource FlatButton}" Click="Island_Click" Margin="0,0,8,0"/>
        <Button Content="—" Width="43" Style="{StaticResource FlatButton}" Click="Minimize_Click" Margin="0,0,5,0"/>
        <Button Content="▢" Width="43" Style="{StaticResource FlatButton}" Click="Maximize_Click" Margin="0,0,5,0"/>
        <Button Content="×" Width="43" Style="{StaticResource FlatButton}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Navigation and workspace -->
  <Grid x:Name="WorkspacePanel" Grid.Row="1" Margin="13,13,13,10">
    <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218"/>
      <ColumnDefinition Width="13"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="5,15,5,3">
           <Border CornerRadius="10" Background="#10191F" BorderBrush="#215769" BorderThickness="1" Padding="10">
             <StackPanel>
               <TextBlock Text="ПРОЕКТ / 01" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
               <TextBlock Text="Network Analytics" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
               <TextBlock Text="Локальный предпросмотр" Style="{StaticResource LabelSmall}" Margin="0,4,0,0"/>
             </StackPanel>
           </Border>
           <TextBlock Margin="5,12,0,0" FontSize="10" Foreground="#7192A6" Text="2026  •  CONTROL CENTER"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="РАБОЧАЯ ПАНЕЛЬ" Style="{StaticResource NavGroupTitle}"/>
          <Button x:Name="NavOverview" Content="⌂   Обзор" Style="{StaticResource NavigationButton}" Click="Overview_Click"/>
          <Button x:Name="NavTraffic" Content="◫   TOP Traffic" Style="{StaticResource NavigationButton}" Click="Traffic_Click"/>
          <Button x:Name="NavConnections" Content="⤳   Соединения" Style="{StaticResource NavigationButton}" Click="Connections_Click"/>
          <Button x:Name="NavReports" Content="▤   Отчёты" Style="{StaticResource NavigationButton}" Click="Reports_Click"/>
          <Button Content="↻   GitHub · Обновления" Style="{StaticResource NavigationButton}" Click="Updates_Click"/>
          <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource NavGroupTitle}"/>
          <Button Content="◉   Проверить адрес" Style="{StaticResource NavigationButton}" Click="RouterCheck_Click"/>
          <Button Content="＋   Загрузить CSV" Style="{StaticResource NavigationButton}" Click="Import_Click"/>
          <Button Content="◌   Сменить акцент" Style="{StaticResource NavigationButton}" Click="Theme_Click"/>
           <Button x:Name="GlassModeButton" Content="✦   Стекло: ПРОЗРАЧНО" Style="{StaticResource NavigationButton}" Click="Glass_Click" ToolTip="Переключить уровень прозрачности: прозрачно, максимум, матово"/>
          <TextBlock Text="ТЕКУЩАЯ ВЕРСИЯ" Style="{StaticResource NavGroupTitle}"/>
          <TextBlock Text="✓ CSV / таблицы / фильтры" Foreground="#7FC8C7" FontSize="11" Margin="9,0,0,7"/>
          <TextBlock Text="✓ HTTP/HTTPS проверка TCP" Foreground="#7FC8C7" FontSize="11" Margin="9,0,0,7"/>
          <TextBlock Text="○ NAT / TOP Traffic API: позже" Foreground="#E2B47D" FontSize="11" TextWrapping="Wrap" Margin="9,0,0,7"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="94"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="142"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="13" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="170"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="ОБЗОР СЕТИ" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="PageSubtitle" Text="Загрузите отчёт от Keenetic Observer v1.9.1" Style="{StaticResource LabelSmall}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,8,0">
            <TextBlock Text="IP устройства" Style="{StaticResource LabelSmall}" Margin="0,0,0,4"/>
            <TextBox x:Name="RouterIP" Text="" Style="{StaticResource TextInput}" ToolTip="Адрес управляемого устройства. Проверка TCP не требует логина."/>
          </StackPanel>
          <Button Grid.Column="2" Content="ПРОВЕРИТЬ TCP" Style="{StaticResource AccentButton}" Margin="6,17,0,1" Click="RouterCheck_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="УСТРОЙСТВА" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiDevices" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="ТРАФИК / ОКНО" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiTraffic" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="УЧТЕНО АКТИВНЫХ" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiActive" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="6" Style="{StaticResource HoverCardBorder}" Padding="15,11">
          <StackPanel><TextBlock Text="ИСТОЧНИК" Style="{StaticResource LabelSmall}"/><TextBlock Text="CSV" Foreground="{DynamicResource Accent}" FontSize="26" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="13">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,2,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TableTitle" Text="ТОП ПОТРЕБИТЕЛЕЙ" FontSize="13" FontWeight="Bold"/>
                <TextBlock x:Name="TableHint" Text="Рейтинг из локального отчёта Keenetic" Style="{StaticResource LabelSmall}" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextInput}" TextChanged="SearchBox_TextChanged"
                       ToolTip="Фильтр по IP, имени устройства или MAC" Margin="5,0,8,0"/>
              <Button Grid.Column="2" Content="ЗАГРУЗИТЬ CSV" Style="{StaticResource AccentButton}" Click="Import_Click"/>
            </Grid>
            <DataGrid Grid.Row="1" x:Name="TrafficGrid" AlternationCount="2" Visibility="Visible">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Width="44" Binding="{Binding Rank}"/>
                <DataGridTextColumn Header="Устройство" MinWidth="150" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="IP" Width="125" Binding="{Binding IP}"/>
                <DataGridTextColumn Header="Получено" Width="96" Binding="{Binding Download}"/>
                <DataGridTextColumn Header="Отправлено" Width="96" Binding="{Binding Upload}"/>
                <DataGridTextColumn Header="Всего" Width="96" Binding="{Binding Total}"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" Visibility="Collapsed" AutoGenerateColumns="True" AlternationCount="2"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="TOP / ПРОФИЛЬ ТРАФИКА" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="По объёму, не по скорости" Style="{StaticResource LabelSmall}" Margin="0,4,0,12"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="TopBars">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,11">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="#D3E8EE" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                    </Grid>
                    <Border Height="7" CornerRadius="4" Background="#1F3345" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Accent}" Width="{Binding Width}" HorizontalAlignment="Left" CornerRadius="4"/>
                    </Border>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Статистика только из доступных источников. Локальные/VPN-потоки могут отсутствовать." Foreground="#8AA7B9" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="СОБЫТИЯ / ЖУРНАЛ" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Выдели текст и нажми Ctrl+C" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,13,0"/>
              <Button Content="⧉  КОПИРОВАТЬ ВСЁ" Style="{StaticResource FlatButton}" Click="CopyAllLogs_Click" ToolTip="Скопировать все строки журнала с отметками времени" Padding="9,5"/>
            </StackPanel>
          </Grid>
          <RichTextBox Grid.Row="1" x:Name="LogList" Background="#F506080B" Foreground="#BBCBD8"
                       FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="7,4"
                       IsReadOnly="True" IsDocumentEnabled="False" AcceptsTab="False"
                       SelectionBrush="#4D458D98" CaretBrush="#43D9DC"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
             <FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="11"
                           ColumnWidth="999999" TextAlignment="Left"/>
          </RichTextBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  <!-- Non-blocking in-app update notification; app must be running. -->
  <Border x:Name="UpdateToast" Grid.Row="1" Panel.ZIndex="15" Visibility="Collapsed"
          Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"
          Padding="17" CornerRadius="14" BorderThickness="1" BorderBrush="#48A6AF" Background="#F5102026">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="7" Opacity="0.6"/></Border.Effect>
    <StackPanel>
      <TextBlock Text="●  НОВАЯ ВЕРСИЯ OBSERVER" FontWeight="Bold" Foreground="#5FE7DD" FontSize="12"/>
      <TextBlock x:Name="UpdateToastText" Text="Доступна новая версия" Foreground="White" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="СМОТРЕТЬ ОБНОВЛЕНИЕ" Style="{StaticResource AccentButton}" Click="Updates_Click" Margin="0,0,9,0"/>
        <Button Content="ПОЗЖЕ" Style="{StaticResource FlatButton}" Click="DismissToast_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
  <Grid Grid.Row="2" Background="#F708090C">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="BottomStatus" Text="READY // Откройте экспорт v1.9.1 или импортируйте CSV" VerticalAlignment="Center"
               Foreground="#74C6CA" FontSize="11" Margin="18,0,0,0"/>
    <TextBlock Grid.Column="1" x:Name="FooterVersionText" Text="OBSERVER  •  AUTHORIZED NETWORKS ONLY" Foreground="#6D91A5" FontSize="10" Margin="0,0,18,0" VerticalAlignment="Center"/>
     <Thumb Grid.ColumnSpan="2" x:Name="CornerResizeGrip" Width="20" Height="20" HorizontalAlignment="Right"
            VerticalAlignment="Bottom" Margin="0,0,1,1" Cursor="SizeNWSE"
            DragDelta="CornerResizeGrip_DragDelta" ToolTip="Изменить размер окна">
       <Thumb.Template>
         <ControlTemplate TargetType="Thumb">
           <Grid Background="Transparent">
             <Path Stroke="#5A9EA9" StrokeThickness="1.6"
                   Data="M 15,5 L 5,15 M 15,10 L 10,15"/>
           </Grid>
         </ControlTemplate>
       </Thumb.Template>
     </Thumb>
  </Grid>
 </Grid>
 </Border>
</Window>
