<Window x:Class="Observer.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Observer.ControlCenter"
 xmlns:loc="clr-namespace:Observer.ControlCenter.Services"
        Icon="/Assets/ObserverBrand.png" Title="{x:Static loc:UiText.X001}" Width="1440" Height="900"
        MinWidth="1040" MinHeight="675" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Opacity="0" Background="Transparent"
        Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" Loaded="Window_Loaded">
 <Window.Resources>
    <Style x:Key="NavGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
      <Setter Property="Margin" Value="9,13,0,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
 </Window.Resources>
 <Border x:Name="GlassShell" BorderBrush="{DynamicResource Tone_71516B74}" BorderThickness="1" Background="{DynamicResource WindowBg}">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="64"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="32"/>
  </Grid.RowDefinitions>

  <!-- Custom chrome / header -->
  <Border Grid.Row="0" BorderBrush="{DynamicResource Tone_1A303A}" BorderThickness="0,0,0,1" Background="{DynamicResource HeaderGradient}">
    <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ui:SnowLayer x:Name="HeaderSnow" Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="True"/>
      <Border Width="44" Height="44" CornerRadius="8" BorderBrush="{DynamicResource Tone_257D8C}" BorderThickness="1" Margin="16,0,12,0" Background="{DynamicResource Tone_080C12}">
        <Grid><Image Source="/Assets/ObserverBrand.png" Margin="4" Stretch="UniformToFill"/></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="OBSERVER" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Tone_F5FCFF}"/>
          <TextBlock Text="{x:Static loc:UiText.X002}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" FontWeight="Normal" FontSize="14"/>
          <TextBlock x:Name="HeaderVersionText" Text="{x:Static loc:UiText.X003}" Margin="12,6,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        </StackPanel>

      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,14,0" VerticalAlignment="Center">
        <Border Visibility="Collapsed" BorderBrush="{DynamicResource Tone_206C6F}" Background="{DynamicResource Tone_113C41}" CornerRadius="11" Padding="12,8" Margin="0,0,12,0">
          <TextBlock Text="{x:Static loc:UiText.X005}" FontSize="10" FontWeight="SemiBold" Foreground="#70E5D7"/>
        </Border>
        <Button x:Name="BtnUpdates" Content="{x:Static loc:UiText.X006}" Style="{StaticResource FlatButton}" Click="Updates_Click" ToolTip="{x:Static loc:UiText.HintUpdates}" Margin="0,0,8,0"/>
        <Button x:Name="BtnSettings" Content="{x:Static loc:UiText.SettingsLabel}" Style="{StaticResource FlatButton}" Click="SettingsMenu_Click" Margin="0,0,8,0"/>
        <Button x:Name="BtnIsland" Content="{x:Static loc:UiText.X007}" Style="{StaticResource FlatButton}" Click="Island_Click" ToolTip="{x:Static loc:UiText.HintIsland}" Margin="0,0,8,0"/>
        <Button Content="—" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintMinimize}" Click="Minimize_Click" Margin="0,0,5,0"/>
        <Button Content="▢" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintMaximize}" Click="Maximize_Click" Margin="0,0,5,0"/>
        <Button Content="×" Width="43" Style="{StaticResource FlatButton}" ToolTip="{x:Static loc:UiText.HintClose}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Navigation and workspace -->
  <Grid x:Name="WorkspacePanel" Grid.Row="1" Margin="16,16,16,12">
    <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="RetiredSidebar" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="5,12,5,3">
           <TextBlock Text="{x:Static loc:UiText.ThemeHeading}" Style="{StaticResource LabelSmall}" Margin="3,0,0,7"/>
           <Grid Margin="0,0,0,12">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Button x:Name="ThemeClassicButton" Style="{StaticResource ThemeChoiceButton}" Click="ClassicTheme_Click" ToolTip="Black Liquid Glass">
               <StackPanel><Border Width="65" Height="24" Background="#080A0D" CornerRadius="5"><Path Data="M0,19 Q16,1 32,12 Q48,23 65,4" Stroke="#92A5B5" StrokeThickness="2" Stretch="Uniform"/></Border><TextBlock Text="Liquid Glass" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
             </Button>
             <Button x:Name="ThemeSignalButton" Grid.Column="2" Style="{StaticResource ThemeChoiceButton}" Click="SignalTheme_Click" ToolTip="Signal">
               <StackPanel><Border Width="65" Height="24" Background="#121B2B" CornerRadius="5"><Grid><Path Data="M0,19 Q16,1 32,12 Q48,23 65,4" Stroke="#69DFFF" StrokeThickness="2" Stretch="Uniform"/><Path Data="M0,4 Q16,22 32,12 Q48,2 65,19" Stroke="#B3A0FF" StrokeThickness="2" Stretch="Uniform"/></Grid></Border><TextBlock Text="Signal" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
             </Button>
           </Grid>
           <Border CornerRadius="10" Background="{DynamicResource Tone_10191F}" BorderBrush="{DynamicResource Tone_215769}" BorderThickness="1" Padding="10">
             <StackPanel>
               <TextBlock Text="{x:Static loc:UiText.X008}" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
               <TextBlock Text="{x:Static loc:UiText.X009}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
               <TextBlock Text="{x:Static loc:UiText.X010}" Style="{StaticResource LabelSmall}" Margin="0,4,0,0"/>
             </StackPanel>
           </Border>
           <TextBlock Margin="5,12,0,0" FontSize="10" Foreground="{DynamicResource Tone_7192A6}" Text="{x:Static loc:UiText.X011}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Margin="0,0,4,0">
          <TextBlock Text="{x:Static loc:UiText.WorkspaceHeading}" FontSize="15" FontWeight="SemiBold" Margin="9,2,0,3"/>
          <TextBlock Text="{x:Static loc:UiText.WorkspaceHint}" Style="{StaticResource LabelSmall}" Margin="9,0,5,8"/>
          
          <Button x:Name="NavOverview" Content="{x:Static loc:UiText.X013}" Style="{StaticResource NavigationButton}" Click="Overview_Click" ToolTip="{x:Static loc:UiText.HintOverview}"/>
          <Button x:Name="NavAccess" Visibility="Collapsed" Content="{x:Static loc:UiText.AccessAnalyzerLabel}" Style="{StaticResource NavigationButton}" Click="AccessAnalyzer_Click"/>
          <Button x:Name="NavConnections" Visibility="Collapsed" Content="{x:Static loc:UiText.X015}" Style="{StaticResource NavigationButton}" Click="Connections_Click" ToolTip="{x:Static loc:UiText.HintConnections}"/>
          <Button x:Name="NavTraffic" Visibility="Collapsed" Content="{x:Static loc:UiText.X014}" Style="{StaticResource NavigationButton}" Click="Traffic_Click" ToolTip="{x:Static loc:UiText.HintTraffic}"/>
          <Button x:Name="NavNat" Visibility="Collapsed" Content="{x:Static loc:UiText.KeeneticConnect}" Style="{StaticResource NavigationButton}" Click="LegacyCollect_Click" ToolTip="{x:Static loc:UiText.HintNat}"/>
          <Button x:Name="NavVpn" Visibility="Collapsed" Content="{x:Static loc:UiText.LegacyVpn}" Style="{StaticResource NavigationButton}" Click="LegacyVpn_Click" ToolTip="{x:Static loc:UiText.HintVpn}"/>
          <Button x:Name="NavCollectTraffic" Visibility="Collapsed" Content="{x:Static loc:UiText.LegacyTraffic}" Style="{StaticResource NavigationButton}" Click="LegacyTraffic_Click" ToolTip="{x:Static loc:UiText.HintCollectTraffic}"/>
          <Button x:Name="NavReports" Content="{x:Static loc:UiText.X016}" Style="{StaticResource NavigationButton}" Click="Reports_Click" ToolTip="{x:Static loc:UiText.HintReports}"/>
          <Button x:Name="NavImport" Visibility="Collapsed" Content="{x:Static loc:UiText.X020}" Style="{StaticResource NavigationButton}" Click="Import_Click" ToolTip="{x:Static loc:UiText.HintImport}"/>
          <Separator Style="{StaticResource GlassSeparator}"/>
          <TextBlock Text="{x:Static loc:UiText.GroupSystem}" Style="{StaticResource NavGroupTitle}"/>
          <Button x:Name="NavTools" Content="{x:Static loc:UiText.LegacyTools}" Style="{StaticResource NavigationButton}" Click="LegacyTools_Click" ToolTip="{x:Static loc:UiText.HintTools}"/>
          <Button x:Name="NavHelp" Content="{x:Static loc:UiText.HelpButton}" Style="{StaticResource NavigationButton}" Click="Help_Click" ToolTip="{x:Static loc:UiText.HelpHint}"/>
          <Button x:Name="GlassModeButton" Visibility="Collapsed" Content="{x:Static loc:UiText.X022}" Style="{StaticResource NavigationButton}" Click="Glass_Click"/>
         </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid x:Name="MainContentGrid" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="WorkRow" Height="3*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition x:Name="ConsoleRow" Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,8">
        <StackPanel>
        <Border x:Name="SignalBanner" Background="{DynamicResource SignalHeroGradient}" CornerRadius="12" BorderBrush="{DynamicResource BrandLine}" BorderThickness="1" Padding="17,9" Margin="0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="KINGPROJECTS / NETWORK TOOLS" Foreground="#A0AEC3" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="OBSERVER CONTROL CENTER" FontSize="23" FontWeight="Bold" Foreground="#F0F5FF" Margin="0,3,0,0"/>
              <TextBlock x:Name="DashboardTagline" Text="Turn connections into evidence." Foreground="#E2EAF7" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Viewbox Grid.Column="1" Height="52" HorizontalAlignment="Right" Margin="0,0,8,0">
              <Canvas Width="150" Height="100">
                <Ellipse Canvas.Left="34" Canvas.Top="9" Width="82" Height="82" Stroke="{DynamicResource BrandLine}" StrokeDashArray="3 4"/>
                <Ellipse Canvas.Left="47" Canvas.Top="22" Width="56" Height="56" Stroke="{DynamicResource BrandLine}"/>
                <Path Data="M75,50 L20,19 M75,50 L127,15 M75,50 L141,52 M75,50 L116,87 M75,50 L22,86 M75,50 L8,51" Stroke="{DynamicResource BrandLine}" StrokeThickness="1.4"/>
                <Ellipse Canvas.Left="14" Canvas.Top="13" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#69DFFF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="121" Canvas.Top="9" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#B3A0FF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="135" Canvas.Top="46" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#69DFFF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="110" Canvas.Top="81" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#B3A0FF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="16" Canvas.Top="80" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#69DFFF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="2" Canvas.Top="45" Width="12" Height="12" Fill="{DynamicResource BrandNode}" Stroke="#B3A0FF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="54" Canvas.Top="29" Width="42" Height="42" Fill="{DynamicResource BrandNode}" Stroke="#69DFFF" StrokeThickness="2"/>
                <Path Data="M59,50 L67,50 L71,42 L77,58 L82,50 L91,50" Stroke="#69DFFF" StrokeThickness="2" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
          </Grid>
        </Border>
        <Grid x:Name="OldConnectionHeader" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="170"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{x:Static loc:UiText.X028}" Foreground="{DynamicResource TextMain}" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="PageSubtitle" Text="{x:Static loc:UiText.X029}" Style="{StaticResource LabelSmall}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,8,0">
            <TextBlock Text="{x:Static loc:UiText.X030}" Style="{StaticResource LabelSmall}" Margin="0,0,0,4"/>
            <TextBox x:Name="RouterIP" Text="" Style="{StaticResource TextInput}" ToolTip="{x:Static loc:UiText.X031}"/>
          </StackPanel>
          <Button Grid.Column="2" Content="{x:Static loc:UiText.LegacyConnect}" Style="{StaticResource AccentButton}" Margin="6,17,0,1" Click="LegacyCollect_Click" ToolTip="{x:Static loc:UiText.HintNat}"/>
        </Grid>
        </StackPanel>
      </Border>
      <UniformGrid x:Name="ModuleTiles" Grid.Row="1" Columns="5" Margin="0,0,0,10"/>
      <Grid x:Name="OldKpiPanel" Grid.Row="2" Height="78" Visibility="Collapsed" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HoverCardBorder}" Background="{DynamicResource Kpi0Gradient}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X033}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiDevices" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource HoverCardBorder}" Background="{DynamicResource Kpi2Gradient}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X034}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiTraffic" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource HoverCardBorder}" Background="{DynamicResource Kpi4Gradient}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X035}" Style="{StaticResource LabelSmall}"/><TextBlock x:Name="KpiActive" Text="—" Style="{StaticResource KpiNumber}"/></StackPanel>
        </Border>
        <Border Grid.Column="6" Style="{StaticResource HoverCardBorder}" Background="{DynamicResource Kpi6Gradient}" Padding="15,11">
          <StackPanel><TextBlock Text="{x:Static loc:UiText.X036}" Style="{StaticResource LabelSmall}"/><TextBlock Text="CSV" Foreground="{DynamicResource Accent}" FontSize="26" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </Grid>
      <Border x:Name="SessionPanel" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="12,7" Margin="0,0,0,10">
        <DockPanel>
          <Button x:Name="SessionToggle" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="SessionToggle_Click" Padding="7,3" Content="⌃" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <DockPanel DockPanel.Dock="Left" Width="184" VerticalAlignment="Center" Margin="0,0,12,0">
            <Path DockPanel.Dock="Left" Data="M2,27 L2,19 L8,19 L8,27 Z M12,27 L12,10 L18,10 L18,27 Z M22,27 L22,2 L28,2 L28,27 Z" Stroke="{DynamicResource TextMain}" StrokeThickness="2" Width="31" Height="31" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel><TextBlock x:Name="SessionTitle" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="SessionHint" Style="{StaticResource LabelSmall}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          </DockPanel>
          <UniformGrid x:Name="SessionMetrics" Columns="4"/>
        </DockPanel>
      </Border>
      <Grid x:Name="OldReportPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="13">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="2,0,2,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TableTitle" Text="{x:Static loc:UiText.X037}" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="TableHint" Text="{x:Static loc:UiText.X038}" Style="{StaticResource LabelSmall}" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextInput}" TextChanged="SearchBox_TextChanged"
                       ToolTip="{x:Static loc:UiText.X039}" Margin="5,0,8,0"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="DashboardTableToggle" Style="{StaticResource FlatButton}" Click="DashboardTableToggle_Click" Margin="0,0,8,0"/><Button x:Name="DashboardExport" Style="{StaticResource FlatButton}" Click="DashboardExport_Click" Margin="0,0,8,0"/><Button x:Name="DashboardActions" Content="⋯" Style="{StaticResource FlatButton}" Click="DashboardActions_Click"/><Button x:Name="DashboardCollapse" Content="⌃" Style="{StaticResource FlatButton}" Click="DashboardCollapse_Click" Margin="8,0,0,0"/></StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" x:Name="TrafficGrid" AlternationCount="2" Visibility="Visible" RowHeight="36" FontSize="13" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Width="44" Binding="{Binding Rank}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X041}" MinWidth="150" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="IP" Width="*" Binding="{Binding IP}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X042}" Width="*" Binding="{Binding Download}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X043}" Width="*" Binding="{Binding Upload}"/>
                <DataGridTextColumn Header="{x:Static loc:UiText.X044}" Width="*" Binding="{Binding Total}"/><DataGridTextColumn x:Name="TrafficStatusColumn" Width="*" Binding="{Binding Status}"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" Visibility="Collapsed" AutoGenerateColumns="True" AlternationCount="2" RowHeight="36" FontSize="13" GridLinesVisibility="Horizontal"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="14">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static loc:UiText.X045}" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="{x:Static loc:UiText.X046}" Style="{StaticResource LabelSmall}" Margin="0,4,0,12"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="TopBars">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Margin="0,0,0,11">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Tone_D3E8EE}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Accent}" FontSize="10"/>
                    </Grid>
                    <Border Height="7" CornerRadius="4" Background="{DynamicResource Tone_1F3345}" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                      <Border Background="{DynamicResource Accent}" Width="{Binding Width}" HorizontalAlignment="Left" CornerRadius="4"/>
                    </Border>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.X047}" Foreground="{DynamicResource Tone_8AA7B9}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="ModuleSurface" Grid.Row="3" Visibility="Collapsed" Style="{StaticResource WorkspaceSection}" Background="Transparent" Padding="0" Margin="0,0,0,8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ModuleCollapse" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="ModuleCollapse_Click" Margin="8,0,0,0"/>
            <TextBlock x:Name="ModuleHeading" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ContentControl x:Name="ModuleHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </DockPanel>
      </Border>
      <Border x:Name="OperationPanel" Grid.Row="4" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel><Button x:Name="ModuleStop" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="ModuleStop_Click" IsEnabled="False" Margin="8,0,0,0" Padding="9,5"/><TextBlock x:Name="ModuleSummary" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
          <ProgressBar x:Name="ModuleProgress" Height="7" Margin="0,7,0,3" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="ModuleProgressText" Style="{StaticResource LabelSmall}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <Border x:Name="LogPanel" Grid.Row="5" Visibility="Collapsed" Style="{StaticResource WorkspaceSection}" Padding="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:UiText.X048}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="LogCount" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,13,0"/>
              <Button x:Name="LogToggle" Content="⌃" Style="{StaticResource FlatButton}" Click="LogToggle_Click" Padding="7,3" Margin="0,0,8,0"/>
              <Button Content="{x:Static loc:UiText.X050}" Style="{StaticResource FlatButton}" Click="CopyAllLogs_Click" ToolTip="{x:Static loc:UiText.X051}" Padding="9,5" Margin="0,0,8,0"/>
              <Button x:Name="ClearDashboardLog" Style="{StaticResource FlatButton}" Click="ClearDashboardLog_Click" Padding="9,5"/>
            </StackPanel>
          </Grid>
          <RichTextBox Grid.Row="1" x:Name="LogList" Background="{DynamicResource Tone_F506080B}" Foreground="{DynamicResource Tone_BBCBD8}"
                       FontFamily="Consolas" FontSize="15" MinHeight="48" Margin="0,6,0,0" BorderThickness="0" Padding="7,4"
                       IsReadOnly="True" IsDocumentEnabled="False" AcceptsTab="False"
                       SelectionBrush="{DynamicResource Tone_4D458D98}" CaretBrush="{DynamicResource Tone_43D9DC}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
             <FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="15"
                           ColumnWidth="999999" TextAlignment="Left"/>
          </RichTextBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  <!-- Non-blocking in-app update notification; app must be running. -->
  <Border x:Name="UpdateToast" Grid.Row="1" Panel.ZIndex="15" Visibility="Collapsed"
          Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"
          Padding="17" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Tone_48A6AF}" Background="{DynamicResource Tone_F5102026}">
    
    <StackPanel>
      <TextBlock Text="{x:Static loc:UiText.X052}" FontWeight="Bold" Foreground="{DynamicResource Tone_5FE7DD}" FontSize="12"/>
      <TextBlock x:Name="UpdateToastText" Text="{x:Static loc:UiText.X053}" Foreground="White" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="{x:Static loc:UiText.X054}" Style="{StaticResource AccentButton}" Click="Updates_Click" Margin="0,0,9,0"/>
        <Button Content="{x:Static loc:UiText.X055}" Style="{StaticResource FlatButton}" Click="DismissToast_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
  <Grid Grid.Row="2" Background="{DynamicResource Tone_F708090C}">
