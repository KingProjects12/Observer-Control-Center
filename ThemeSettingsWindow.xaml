<Window x:Class="Observer.ControlCenter.ThemeSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="960" Height="760" MinWidth="680" MinHeight="460"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogBg}"
 Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="16,12">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource PanelBg2}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource PanelBg2}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TabControl">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TabPanel IsItemsHost="True" Margin="0,0,0,12"/>
      <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock x:Name="Description" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <TabControl Grid.Row="1">
   <TabItem x:Name="ThemesTab">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Margin="4,0,4,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="CollectionLabel" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/><ComboBox x:Name="CollectionFilter"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock x:Name="SearchLabel" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/><TextBox x:Name="ThemeSearch"/></StackPanel>
     </Grid>
     <TextBlock x:Name="ResultsLabel" DockPanel.Dock="Top" Foreground="{DynamicResource TextSecondary}" Margin="4,0,4,8"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <UniformGrid x:Name="Gallery" Columns="4"/>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem x:Name="EffectsTab">
    <StackPanel>
     <TextBlock x:Name="EffectsHeading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <CheckBox x:Name="SnowOption" Margin="0,0,0,12"/>
     <TextBlock x:Name="EffectsHint" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,16,0,0">
   <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" MinWidth="100" IsCancel="True" Click="Done_Click"/>
   <TextBlock x:Name="CurrentLabel" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
  </DockPanel>
 </Grid>
</Window>
