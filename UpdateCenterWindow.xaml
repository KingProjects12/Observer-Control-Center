<Window x:Class="Observer.ControlCenter.UpdateCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Observer.ControlCenter.Services"
 Icon="/Assets/ObserverBrand.png" Title="{x:Static loc:UiText.X059}" Width="690" Height="610" MinWidth="620" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="#070809" Foreground="#EAF4FA"
 ResizeMode="CanResize" WindowStyle="SingleBorderWindow" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#111B25"/>
   <Setter Property="Foreground" Value="#E9F7FD"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="0,0,9,0"/>
   <Setter Property="BorderBrush" Value="#286880"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#10151C"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#327A8A"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Window.Resources>
 <Grid Margin="26,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="{x:Static loc:UiText.X060}" Foreground="#45DFE7" FontWeight="Bold" FontSize="19"/>
   <TextBlock x:Name="InstalledVersion" Foreground="#91B2C7" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Padding="16" Background="#101215" CornerRadius="13" BorderBrush="#2B4950" BorderThickness="1" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="{x:Static loc:UiText.X061}" FontSize="11" Foreground="#93BFD0"/>
    <TextBox x:Name="RepoBox" Margin="0,7,0,9" ToolTip="{x:Static loc:UiText.X062}"/>
    <DockPanel LastChildFill="False">
     <CheckBox DockPanel.Dock="Left" x:Name="AutoCheckBox" Content="{x:Static loc:UiText.X063}" VerticalAlignment="Center" Foreground="#E4F2F6"/>
     <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.X064}" HorizontalAlignment="Right" x:Name="SaveButton" Click="Save_Click"/>
    </DockPanel>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="#0B0D10" BorderBrush="#256A79" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="{x:Static loc:UiText.X065}" Foreground="#63E3D4" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ProgressBar x:Name="InstallProgress" Height="7" Minimum="0" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
    <TextBlock Text="{x:Static loc:UiText.X066}" Foreground="#9CB5C8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <WrapPanel Grid.Row="3" Margin="0,0,0,9">
   <Button x:Name="CheckButton" Content="{x:Static loc:UiText.X067}" Click="Check_Click"/>
   <Button x:Name="InstallButton" Content="{x:Static loc:UiText.X068}" Click="Install_Click" Visibility="Collapsed" Background="#17616A"/>
   <Button x:Name="CancelInstallButton" Content="{x:Static loc:UiText.X069}" Click="CancelInstall_Click" Visibility="Collapsed"/>
   <Button x:Name="OpenButton" Content="{x:Static loc:UiText.X070}" Click="Open_Click"/>
   <Button x:Name="DismissButton" Content="{x:Static loc:UiText.X071}" Click="Dismiss_Click" Visibility="Collapsed"/>
  </WrapPanel>
  <Border Grid.Row="4" Background="#090B0E" CornerRadius="12" BorderThickness="1" BorderBrush="#253940" Padding="15">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:UiText.X072}" Foreground="#48D9E5" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReleaseNotes" Text="{x:Static loc:UiText.X073}" TextWrapping="Wrap" FontSize="12" Foreground="#C3D9E8"/></ScrollViewer>
   </DockPanel>
  </Border>
  <TextBlock Grid.Row="5" Margin="0,13,0,0" FontSize="10" Foreground="#7E9FB4" TextWrapping="Wrap"
   Text="{x:Static loc:UiText.X074}"/>
 </Grid>
</Window>
