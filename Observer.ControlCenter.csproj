<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Observer.ControlCenter</AssemblyName>
    <RootNamespace>Observer.ControlCenter</RootNamespace>
    <Version>2.0.4-preview.1</Version>
    <ObserverUpdateRepo Condition="'$(ObserverUpdateRepo)' == ''"></ObserverUpdateRepo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single-EXE settings are passed by Publish-SingleExe.ps1; don't force them for Debug. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ObserverUpdateRepo</_Parameter1>
      <_Parameter2>$(ObserverUpdateRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ObserverEye.png" />
  </ItemGroup>
</Project>
