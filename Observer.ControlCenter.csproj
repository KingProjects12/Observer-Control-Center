<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Observer.ControlCenter</AssemblyName>
    <RootNamespace>Observer.ControlCenter</RootNamespace>
    <Version>2.5.5</Version>
    <ObserverUpdateRepo Condition="'$(ObserverUpdateRepo)' == ''"></ObserverUpdateRepo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ObserverApp.ico</ApplicationIcon>
    <!-- Single-EXE settings are passed by Publish-SingleExe.ps1; don't force them for Debug. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs;LegacyCollectorTests/**/*.cs" />
    <EmbeddedResource Include="LegacyCollector/Assets/TrafficNetworkAnalyticsTemplate.xlsx" LogicalName="TrafficNetworkAnalyticsTemplate.xlsx" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ObserverUpdateRepo</_Parameter1>
      <_Parameter2>$(ObserverUpdateRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ObserverBrand.png" />
  </ItemGroup>
  <!-- Generate the Windows shell/taskbar icon before the WPF build. No external tooling. -->
  <Target Name="GenerateObserverAppIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Generate-BrandIcon.ps1&quot; -Target &quot;$(MSBuildProjectDirectory)\Assets\ObserverBrand.png&quot;" />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Generate-AppIcon.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\Assets\ObserverBrand.png&quot; -Target &quot;$(MSBuildProjectDirectory)\Assets\ObserverApp.ico&quot;" />
  </Target>
</Project>
