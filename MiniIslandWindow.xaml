<Window x:Class="Observer.ControlCenter.MiniIslandWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Observer.ControlCenter.Services"
  Title="{x:Static loc:UiText.X081}" Width="405" Height="76" WindowStyle="None"
  ShowInTaskbar="False" ShowActivated="False" Topmost="True" Opacity="0"
  ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
  <Border x:Name="IslandSurface" Margin="8" CornerRadius="23" BorderThickness="1"
          BorderBrush="{DynamicResource Stroke}" Cursor="Hand" MouseLeftButtonDown="Island_MouseLeftButtonDown"
          Background="{DynamicResource PanelBg}">
    <Border.RenderTransform><TranslateTransform x:Name="IslandOffset" Y="0"/></Border.RenderTransform>
    
    <Grid Margin="16,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="/Assets/ObserverBrand.png" Width="28" Height="28" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Observer" Foreground="{DynamicResource TextMain}" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" FontSize="13"/>
      </StackPanel>
      <TextBlock Grid.Column="2" x:Name="CountText" MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
    </Grid>
  </Border>
</Window>
