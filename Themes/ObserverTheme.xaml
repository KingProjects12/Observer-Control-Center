<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBg" Color="#FD050608"/>
  <SolidColorBrush x:Key="PanelBg" Color="#ED080A0D"/>
  <SolidColorBrush x:Key="PanelBg2" Color="#F00F1216"/>
  <SolidColorBrush x:Key="Stroke" Color="#273A49"/>
  <SolidColorBrush x:Key="Accent" Color="#3DE7EA"/>
  <SolidColorBrush x:Key="Accent2" Color="#B392FF"/>
  <SolidColorBrush x:Key="TextMain" Color="#EDF5FB"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#92A5B5"/>
  <SolidColorBrush x:Key="Positive" Color="#3BD5AA"/>

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E912151A" Offset="0"/>
          <GradientStop Color="#EE090B0E" Offset="0.53"/>
          <GradientStop Color="#ED0D1014" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="17"/>
    <Setter Property="Padding" Value="17"/>
  </Style>

  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="Background" Value="{StaticResource PanelBg2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" SnapsToDevicePixels="True">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="BackgroundBorder" Property="Background" Value="#181D22"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.76"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="#113139"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Height" Value="43"/>
    <Setter Property="RenderTransform">
      <Setter.Value><TranslateTransform X="0"/></Setter.Value>
    </Setter>
    <Style.Triggers>
      <EventTrigger RoutedEvent="MouseEnter">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="4" Duration="0:0:0.12"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
      <EventTrigger RoutedEvent="MouseLeave">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.16"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>
  <!-- Tiny lift effects for KPI panels, without reflow or layout jitter. -->
  <Style x:Key="HoverCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
    <Setter Property="RenderTransform">
      <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
    </Setter>
    <Style.Triggers>
      <EventTrigger RoutedEvent="MouseEnter">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="-3" Duration="0:0:0.14"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
      <EventTrigger RoutedEvent="MouseLeave">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="0" Duration="0:0:0.18"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TextInput" TargetType="TextBox">
    <Setter Property="Background" Value="#07090B"/>
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="BaseBorder" CornerRadius="10" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LabelSmall" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="KpiNumber" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="#F007090C"/>
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="#ED0A0C10"/>
    <Setter Property="AlternatingRowBackground" Value="#EF111418"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#202C38"/>
    <Setter Property="VerticalGridLinesBrush" Value="#202C38"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="RowHeight" Value="35"/>
    <Setter Property="ColumnHeaderHeight" Value="38"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="EnableColumnVirtualization" Value="True"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F015191E"/>
    <Setter Property="Foreground" Value="#C5E9F3"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="BorderBrush" Value="#273845"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#1B2228"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#173E48"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dark liquid-glass scrollbars shared by DataGrid, console and report panels. -->
  <Style x:Key="GlassScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="RailThumb" CornerRadius="5" Margin="2,1"
                  Background="#28424C" BorderBrush="#456A74" BorderThickness="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RailThumb" Property="Background" Value="#356D78"/>
              <Setter TargetName="RailThumb" Property="BorderBrush" Value="#3DE7EA"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="RailThumb" Property="Background" Value="#2E9BA5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlassScrollPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="GlassVerticalScroll" TargetType="{x:Type ScrollBar}">
    <Border Background="#06090F" Width="12" CornerRadius="6">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource GlassScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource GlassScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource GlassScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="GlassHorizontalScroll" TargetType="{x:Type ScrollBar}">
    <Border Background="#06090F" Height="12" CornerRadius="6">
      <Track x:Name="PART_Track" Orientation="Horizontal">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource GlassScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource GlassScrollThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource GlassScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template" Value="{StaticResource GlassVerticalScroll}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template" Value="{StaticResource GlassHorizontalScroll}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
